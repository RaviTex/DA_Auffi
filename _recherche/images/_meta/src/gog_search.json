        (function () {
            var v3 = false;
            try { v3 = !document.querySelector('link[href*="menu_website3"]'); } catch (e) {}
            /* Purely structural now — the stylesheet already hid the loser. The loser must still
               be REMOVED rather than left hidden, or its directives would compile. Every v2-owned
               element carries `menu-ab-v2`, the announcement bar included (V2/main's `aboveMenu`
               override passes `abClass`); miss one and CZ/HU/RO/ZA/TR/KZ users on a mismatched
               currency would end up with two bars. */
            var doomed = document.querySelectorAll(v3 ? '.menu-ab-v2' : '.menu-ab-v3-host');
            for (var i = 0; i < doomed.length; i++) {
                doomed[i].parentNode.removeChild(doomed[i]);
            }
            /* Resolve v3's `--auth-pending` from the menuData cache the bundle restores at bootstrap
               anyway (MenuDataClientFactory prefix + MenuBasicUserDataEndpointSource key), so repeat
               visitors get the right top bar on first paint. The bundle can't do this sooner: its
               eval and bootstrap are one task, with no paint in between. */
            var nav = v3 && document.querySelector('nav.menu-v3.menu-v3--auth-pending');
            if (nav) {
                try {
                    var data = JSON.parse(window.localStorage.getItem('dataClient_menuData'));
                    if (data && typeof data.isLoggedIn === 'boolean') {
                        nav.classList.remove('menu-v3--auth-pending');
                        nav.classList.toggle('menu-v3--logged-in', data.isLoggedIn);
                    }
                } catch (e) {}
            }
        })();
